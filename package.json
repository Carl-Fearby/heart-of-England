{
  "name": "heart-of-england",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "images:sync": "node scripts/sync-source-assets.mjs",
    "images:optimise": "node scripts/optimise-images.mjs",
